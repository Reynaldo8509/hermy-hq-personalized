generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Draft {
  id              String    @id @default(uuid())
  text            String
  title           String?
  model           String?
  status          String    @default("pending")
  type            String?
  category        String?
  hookType        String?
  feedbackRating  String?
  feedbackReason  String?
  viralScore      Json?
  impressionScore Json?
  scheduledDate   String?
  scheduledTime   String?
  visualUrl       String?
  variantGroup    String?
  postedAt        DateTime?
  postedUrl       String?
  tweetUrl        String?
  tweetId         String?
  metrics         Json?
  editHistory     Json?     @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  quoteUrl        String?
  quoteText       String?

  // Content intelligence fields
  source          String? // "sage" | "organic" | "csv_import"
  engagementScore Float? // time-weighted composite score (updated by scoring engine)
  engagementTier  String? // "top20" | "bottom20" | null (cleared/set on rescore)

  @@index([status])
  @@index([createdAt])
  @@index([tweetId])
  @@index([source])
  @@index([engagementTier])
}

model TweetMetric {
  id          String    @id @default(cuid())
  draftId     String
  tweetId     String?
  url         String?
  postedAt    DateTime?
  checkpoints Json?
  createdAt   DateTime  @default(now())

  @@index([draftId])
}

model Idea {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  type        String?
  model       String?
  status      String?
  timestamp   DateTime @default(now())

  @@index([category])
  @@index([type])
}

model ContentCalendar {
  id   String @id @default(cuid())
  week String @unique
  data Json
}

model YoutubeIdea {
  id               String   @id @default(cuid())
  title            String
  hook             String?
  angle            String?
  hookType         String?
  funnelStage      String?
  status           String   @default("pending")
  rejectedReason   String?
  sourceUrl        String?
  sourceSummary    String?
  competitionScore String? // "gap" | "moderate" | "crowded"
  competitionData  Json? // { resultCount, avgViews, topVideos[], scoredAt }
  createdAt        DateTime @default(now())

  @@index([status])
}

model YoutubeScript {
  id               String   @id @default(cuid())
  title            String
  hook             String?
  storySetup       String?
  conflict         String?
  insight          String?
  cta              String?
  caption          String?
  onScreenText     String?
  hookType         String?
  funnelStage      String?
  factCheck        Json?
  fullScript       String?
  status           String   @default("draft")
  rejectedReason   String?
  // SEO Package
  seoTitle         String?
  seoDescription   String?
  seoTags          Json?
  seoChapters      Json?
  titleVariants    Json?
  thumbnailConcept String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

model YoutubeFeedback {
  id     String   @id @default(cuid())
  title  String
  reason String?
  type   String?
  date   DateTime @default(now())
}

model LongformScript {
  id               String    @id @default(cuid())
  title            String
  type             String?
  status           String    @default("draft")
  platform         String?
  platforms        Json?
  description      String?
  hook             String?
  outline          String?
  fullScript       String?
  targetLength     String?
  factCheck        Json?
  notes            String?
  rejectedReason   String?
  youtubeUrl       String?
  thumbnailUrl     String?
  tweetUrl         String?
  youtubeViews     Int?
  youtubeLikes     Int?
  youtubeComments  Int?
  tweetViews       Int?
  tweetLikes       Int?
  tweetBookmarks   Int?
  tweetRetweets    Int?
  tweetReplies     Int?
  postedAt         DateTime?
  competitionScore String? // "gap" | "moderate" | "crowded"
  competitionData  Json? // { resultCount, avgViews, topVideos[], scoredAt }
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

model AgentState {
  id             String    @id
  name           String
  emoji          String?
  role           String?
  status         String    @default("offline")
  lastActive     DateTime?
  tasksCompleted Int       @default(0)
  totalCost      Float     @default(0)
  currentTask    String?
  recentActivity Json?     @default("[]")
  updatedAt      DateTime  @updatedAt
}

model AgentBusMessage {
  id        String   @id @default(uuid())
  fromAgent String
  toAgent   String
  type      String
  content   String
  metadata  Json?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())

  @@index([toAgent, read])
  @@index([fromAgent])
}

model BattleRoyaleBot {
  id        String   @id
  state     Json
  updatedAt DateTime @updatedAt
}

model ContentRequest {
  id             String    @id @default(uuid())
  prompt         String
  status         String    @default("pending")
  resultDraftIds Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

// ─── Generic Key-Value Store ────────────────────────────────────

model DataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// ─── Daily Briefs ───────────────────────────────────────────────

model Brief {
  id        String   @id @default(cuid())
  date      String   @unique
  content   String   @db.Text
  source    String   @default("brief")
  createdAt DateTime @default(now())
}

// ─── Missions ───────────────────────────────────────────────────

model Mission {
  id          String    @id @default(uuid())
  agentId     String
  title       String
  description String    @db.Text
  status      String    @default("pending") // pending, active, completed, failed
  priority    String    @default("medium") // high, medium, low
  result      String?   @db.Text
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([agentId])
  @@index([status])
}

// ─── Articles ───────────────────────────────────────────────────

model Article {
  id              String    @id @default(uuid())
  title           String
  body            String    @db.Text
  track           String // "mega-viral" | "local-viral" | "icp-viral"
  status          String    @default("idea") // "idea" | "draft" | "ready" | "posted"
  qtTweet         String?   @db.Text
  qtUrl           String?
  heroImageUrl    String?
  heroImageHtml   String?   @db.Text
  inspirationUrls String?   @db.Text // JSON array of URLs
  themes          String? // JSON array of themes
  scheduledDate   String?
  postedAt        DateTime?
  postedUrl       String?
  impressions     Int?
  likes           Int?
  bookmarks       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([track])
  @@index([scheduledDate])
}

model SavedTitle {
  id        String   @id @default(cuid())
  title     String
  track     String
  themes    String? // JSON array
  createdAt DateTime @default(now())

  @@index([track])
}

// ─── Client Pulse Telegram Bot ─────────────────────────────────

model ClientPulseClient {
  id                   String                @id @default(cuid())
  notionPageId         String?               @unique
  clientName           String
  status               String?
  services             Json                  @default("[]")
  productManagerName   String?
  renewalDate          DateTime?
  endDate              DateTime?
  expectedCheckinHours Int                   @default(72)
  sourceUpdatedAt      DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  chats                ClientPulseChat[]
  analyses             ClientPulseAnalysis[]
  alerts               ClientPulseAlert[]

  @@index([status])
  @@index([clientName])
  @@index([productManagerName])
}

model ClientPulseChat {
  id              String               @id @default(cuid())
  telegramChatId  String               @unique
  title           String
  linkedClientId  String?
  status          String               @default("active")
  internalUserIds Json                 @default("[]")
  lastSeenAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  linkedClient    ClientPulseClient?   @relation(fields: [linkedClientId], references: [id], onDelete: SetNull)
  messages        ClientPulseMessage[]
  alerts          ClientPulseAlert[]

  @@index([linkedClientId])
  @@index([status])
}

model ClientPulseMessage {
  id                String           @id @default(cuid())
  telegramMessageId String
  telegramChatId    String
  chatId            String?
  senderTelegramId  String
  senderName        String
  isInternal        Boolean          @default(false)
  isBot             Boolean          @default(false)
  text              String           @db.Text
  sentAt            DateTime
  intent            String           @default("other")
  sentiment         String           @default("neutral")
  needsReply        Boolean          @default(false)
  rawJson           Json?
  createdAt         DateTime         @default(now())
  chat              ClientPulseChat? @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@unique([telegramChatId, telegramMessageId])
  @@index([telegramChatId, sentAt])
  @@index([chatId, sentAt])
  @@index([needsReply])
}

model ClientPulseAnalysis {
  id                  String            @id @default(cuid())
  clientId            String
  windowStart         DateTime
  windowEnd           DateTime
  sentimentScore      Int
  responseScore       Int
  cadenceScore        Int
  renewalRiskScore    Int
  positiveSignalScore Int               @default(70)
  overallScore        Int
  category            String
  reasons             Json              @default("[]")
  evidence            Json              @default("[]")
  recommendedAction   String?           @db.Text
  llmSummary          String?           @db.Text
  analysisSource      String            @default("fallback")
  analyzedAt          DateTime          @default(now())
  client              ClientPulseClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, analyzedAt])
  @@index([category])
  @@index([overallScore])
}

model ClientPulseAlert {
  id                String             @id @default(cuid())
  clientId          String?
  chatId            String?
  type              String
  severity          String
  evidence          Json               @default("[]")
  reason            String             @db.Text
  recommendedAction String?            @db.Text
  sentTo            String?
  sentAt            DateTime?
  acknowledgedAt    DateTime?
  createdAt         DateTime           @default(now())
  client            ClientPulseClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  chat              ClientPulseChat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([severity])
  @@index([sentAt])
  @@index([acknowledgedAt])
}

// ─── Hermes bus (Hermy HQ website ↔ Hermes on the Mac mini) ─────
// Shared Postgres is the message bus. A bridge on the mini polls
// AgentRequest, runs approved/safe ones via the `hermes` CLI, and
// mirrors kanban tasks + activity back into HermesTask / AgentEvent.

model AgentRequest {
  id             String    @id @default(cuid())
  origin         String    @default("web") // "web" | "hermes"
  kind           String    @default("oneshot") // "oneshot" | "kanban" | "chat"
  title          String
  prompt         String?
  sideEffecting  Boolean   @default(false)
  action         String?
  capability     String?
  contractVersion Int      @default(1)
  executionMode  String?
  scope          Json?
  privacyClass   String?
  requestedBy    String?
  authSource     String?
  riskReasons    Json?
  status         String    @default("queued") // queued | awaiting_approval | approved | running | done | failed | rejected
  result         String?
  error          String?
  hermesTaskId   String?
  idempotencyKey String?   @unique
  dependsOn      Json      @default("[]")
  decidedAt      DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  delegatedDecision DelegatedApprovalDecision?
  delegatedAudits DelegatedApprovalAudit[]

  @@index([status])
  @@index([createdAt])
}

model AgentEvent {
  id        String   @id @default(cuid())
  kind      String   @default("activity") // activity | run | status | memory
  title     String
  detail    String?
  agent     String?
  level     String   @default("info") // info | up | warn | down
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ActionApproval {
  id                  String    @id
  request_id          String
  action              String
  status              String    @default("pending")
  requested_by        String
  approved_by         String?
  rejected_by         String?
  resolved_by         String?
  decision            String?
  approvalMethod      String?   @map("approval_method")
  result              String?
  incident_id         String?
  reason              String?
  created_at          DateTime  @default(now()) @db.Timestamp(6)
  resolved_at         DateTime? @db.Timestamp(6)
  expires_at          DateTime? @db.Timestamp(6)
  parameters_snapshot Json?
  delegatedDecision   DelegatedApprovalDecision?

  @@index([status, created_at(sort: Desc)], map: "ActionApproval_pending_idx")
}

model DelegatedApprovalPolicy {
  id                 String   @id
  version            Int
  policy_hash        String   @unique
  issuer             String
  rule_ids           Json
  resource_ids_by_rule Json
  enabled            Boolean  @default(false)
  issued_at          DateTime @db.Timestamptz(6)
  expires_at         DateTime @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  revoked_by         String?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  decisions          DelegatedApprovalDecision[]
  audits             DelegatedApprovalAudit[]

  @@index([enabled, expires_at])
}

model DelegatedApprovalDecision {
  id                  String   @id
  request_id          String   @unique
  approval_id         String   @unique
  policy_id           String
  policy_version      Int
  policy_hash         String
  rule_id             String
  request_fingerprint String
  delegated_actor     String
  status              String   @default("issued")
  issued_at           DateTime @default(now()) @db.Timestamptz(6)
  expires_at          DateTime @db.Timestamptz(6)
  consumed_at         DateTime? @db.Timestamptz(6)
  request             AgentRequest @relation(fields: [request_id], references: [id], onDelete: Restrict)
  approval            ActionApproval @relation(fields: [approval_id], references: [id], onDelete: Restrict)
  policy              DelegatedApprovalPolicy @relation(fields: [policy_id], references: [id], onDelete: Restrict)

  @@index([policy_id, status, expires_at])
}

model DelegatedApprovalAudit {
  id                  String   @id
  actor               String
  event               String
  policy_id           String?
  request_id          String?
  approval_id         String?
  policy_hash         String?
  request_fingerprint String?
  detail              Json
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  policy              DelegatedApprovalPolicy? @relation(fields: [policy_id], references: [id], onDelete: Restrict)
  request             AgentRequest? @relation(fields: [request_id], references: [id], onDelete: Restrict)

  @@index([policy_id, created_at])
  @@index([request_id, created_at])
}

model IncidentMemory {
  id          String    @id
  fingerprint String
  incident    String
  evidence    String
  cause       String
  hypothesis  String
  remediation String
  validation  String
  provider    String?
  model       String?
  duration_ms BigInt?
  invalid_duration_ms BigInt?
  cause_confirmed Boolean?
  status      String    @default("open")
  agent       String?
  request_id  String?
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @db.Timestamp(6)
  closed_at   DateTime? @db.Timestamp(6)
  attempts    Json?
  limitations String    @default("No limitaciones registradas.")
  next_action String    @default("Sin siguiente acción registrada.")

  @@index([fingerprint, updated_at(sort: Desc)], map: "IncidentMemory_fingerprint_idx")
  @@index([request_id], map: "IncidentMemory_request_idx")
  @@index([status, updated_at(sort: Desc)], map: "IncidentMemory_status_idx")
  @@index([evidence(ops: raw("gin_trgm_ops"))], map: "incident_memory_evidence_trgm_idx", type: Gin)
  @@index([incident(ops: raw("gin_trgm_ops"))], map: "incident_memory_incident_trgm_idx", type: Gin)
}

model InferenceAttempt {
  id          String    @id
  request_id  String
  attempt_no          Int
  attempt_number      Int?
  provider            String
  model               String
  requested_provider  String?
  requested_model     String?
  gateway             String?
  actual_provider     String?
  actual_model        String?
  underlying_provider String?
  status              String
  reason              String?
  error_class         String?
  failover_reason     String?
  cost_source         String?
  duration_ms         BigInt?
  started_at          DateTime? @db.Timestamp(6)
  prompt_tokens       BigInt?
  uncached_prompt_tokens BigInt?
  completion_tokens   BigInt?
  total_tokens        BigInt?
  reported_cost       Float?
  cost_currency       String?
  cost_status         String   @default("unknown")
  free_route          Boolean?
  route_cost_policy   String?
  reasoning_tokens    BigInt?
  cache_read_tokens   BigInt?
  cache_write_tokens  BigInt?
  api_calls           Int?
  remote_attempted    Boolean?
  remote_attempt_status String?
  usage_source        String?
  http_status         Int?
  auxiliary_total_tokens BigInt?
  total_including_auxiliary_tokens BigInt?
  usage_scope         String?
  privacy_class       String?
  complexity_class    String?
  route_tier          String?
  fallback_count      Int       @default(0)
  finish_reason       String?
  structured_output_valid Boolean?
  created_at          DateTime  @default(now()) @db.Timestamp(6)
  finished_at         DateTime? @db.Timestamp(6)

  @@index([request_id, attempt_no], map: "InferenceAttempt_request_idx")
}

model HermesTask {
  id        String   @id // Hermes task id
  board     String   @default("default")
  title     String
  assignee  String?
  status    String   @default("todo")
  priority  Int?
  result    String?
  updatedAt DateTime @default(now())
  syncedAt  DateTime @updatedAt

  @@index([board])
  @@index([status])
}

// ─── Hermes Memory Wiki (warm tier — git-tracked markdown, mirrored) ─────
model HermesMemory {
  id         String    @id // wiki entry slug (relative path w/o .md)
  path       String // file path relative to wiki root
  type       String    @default("fact")
  title      String
  status     String    @default("active")
  confidence String?
  provenance String?
  tags       String[]
  links      String[]
  body       String    @default("")
  validFrom  DateTime?
  validTo    DateTime?
  updatedAt  DateTime  @default(now())
  syncedAt   DateTime  @updatedAt

  @@index([type])
  @@index([status])
}
